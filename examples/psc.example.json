{
  "version": 1,
  "name": "example-psc",
  "adapter": "psc-bridge",
  "transport": {
    "exec_argv": [
      "ssh",
      "-o",
      "BatchMode=yes",
      "<login-alias>",
      "bash -s"
    ]
  },
  "verified": {
    "scheduler": "slurm",
    "local_disk": null,
    "persistent_archive": null,
    "compute_ssh": null,
    "project_qos": [],
    "partition_qos": {},
    "default_qos_allowed": null
  },
  "storage": {
    "local_template": "/local/slurm-$SLURM_JOB_ID/local/agent",
    "local_prefix": "/local/",
    "archive": "/project/<project>/<user>/workspace.tar.zst",
    "results": "/project/<project>/<user>/results"
  },
  "allocation": {
    "account": "<account>",
    "cpus": 2,
    "memory": "8G",
    "walltime": "00:04:00",
    "default_gpu": "v100",
    "local_scratch": "",
    "gpus": {
      "v100": {
        "gres": "v100-32",
        "partition": "GPU-shared",
        "qos": "",
        "max_count": 1
      }
    }
  }
}
